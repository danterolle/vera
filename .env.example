VERA_LIVE_SOURCES=true
VERA_SOURCE_WORKERS=5
VERA_LLM_PROVIDER=deterministic
VERA_LLM_MODEL=llama3.1:8b
VERA_LLM_BASE_URL=http://localhost:11434
VERA_LLM_API_KEY=
VERA_REACT_ENABLED=false
VERA_MAX_REACT_STEPS=3
VERA_GEMINI_API_KEY=
VERA_NVD_API_KEY=
VERA_GROUNDING_MIN_COVERAGE=0.55
VERA_EMBEDDING_BACKEND=hash
VERA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VERA_RETRIEVAL_MIN_SCORE=0.05
VERA_DB_PATH=.vera/vera.db
VERA_CORPUS_DIR=.vera/corpus
VERA_PORT_SCAN_THRESHOLD=10
VERA_PORT_SCAN_WINDOW_SECONDS=60
VERA_AUTH_FAILURE_THRESHOLD=5
VERA_AUTH_FAILURE_WINDOW_SECONDS=300
VERA_SYN_BURST_THRESHOLD=20
VERA_SYN_BURST_WINDOW_SECONDS=10
